# Supabase Postgres — pooler (for app queries)
# Replace YOUR_PROJECT_REF and YOUR_PASSWORD with your Supabase credentials.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Postgres — direct (for Prisma migrations only)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.supabase.com:5432/postgres"
